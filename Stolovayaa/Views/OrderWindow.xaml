<Window x:Class="Stolovayaa.Views.OrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Создание заказа"
        Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#E8F0FE">

    <Window.Resources>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="5,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BeigeButton" TargetType="Button">
            <Setter Property="Background" Value="#D9C7A7"/>
            <Setter Property="Foreground" Value="#4A3F2A"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C9B48F"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#B8A178"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BeigeDarkButton" TargetType="Button" BasedOn="{StaticResource BeigeButton}">
            <Setter Property="Background" Value="#C9B48F"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#B8A178"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#A69064"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="White" CornerRadius="15" Margin="15" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text=" Создание заказа"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#2C3E50"
                       Margin="0,0,0,12"/>

            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="Ученик" FontSize="12" FontWeight="SemiBold"
                               Foreground="#34495E" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Schoolboys}"
                              SelectedItem="{Binding SelectedSchoolboy}"
                              DisplayMemberPath="FullName"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="Меню на дату" FontSize="12" FontWeight="SemiBold"
                               Foreground="#34495E" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Menus}"
                              SelectedItem="{Binding SelectedMenu}"
                              DisplayMemberPath="Date"/>
                </StackPanel>
            </Grid>
            
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#FBF7F0" CornerRadius="10" Padding="12" Margin="0,0,8,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Доступные блюда"
                                   FontSize="14" FontWeight="Bold"
                                   Foreground="#2C3E50" Margin="0,0,0,8"/>

                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding Dishes}"
                                 SelectedItem="{Binding SelectedDish}"
                                 DisplayMemberPath="Title"
                                 BorderThickness="0"
                                 Background="Transparent"/>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="Порций:" VerticalAlignment="Center"
                                       Margin="0,0,8,0" Foreground="#34495E"/>
                            <TextBox Text="{Binding Portions}" Width="50" Margin="0,0,8,0"/>
                            <Button Content="Добавить" Command="{Binding AddDishCommand}"
                                    Style="{StaticResource BeigeButton}" Width="106"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Background="#FBF7F0" CornerRadius="10" Padding="12" Margin="8,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Корзина"
                                   FontSize="14" FontWeight="Bold"
                                   Foreground="#2C3E50" Margin="0,0,0,8"/>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding Cart}"
                                  SelectedItem="{Binding SelectedCartItem}"
                                  AutoGenerateColumns="False"
                                  BorderThickness="0"
                                  Background="White"
                                  RowBackground="White"
                                  AlternatingRowBackground="#FBF7F0"
                                  GridLinesVisibility="None"
                                  HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Блюдо" Binding="{Binding DishId}" Width="*"/>
                                <DataGridTextColumn Header="Кол-во" Binding="{Binding Count}" Width="70"/>
                                <DataGridTextColumn Header="Цена" Binding="{Binding PriceAtOrder}" Width="70"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Button Grid.Row="2" Content="Удалить" Command="{Binding RemoveDishCommand}"
                                Style="{StaticResource BeigeButton}" Margin="0,8,0,0"/>
                    </Grid>
                </Border>
            </Grid>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <TextBlock Text="Итого: " FontSize="15" FontWeight="Bold"
                           Foreground="#2C3E50" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding TotalAmount}" FontSize="15" FontWeight="Bold"
                           Foreground="#A69064" VerticalAlignment="Center" Margin="5,0,0,0"/>
                <Button Content="Сохранить заказ" Command="{Binding SaveOrderCommand}"
                        Style="{StaticResource BeigeDarkButton}" Margin="20,0,0,0" Width="126"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>