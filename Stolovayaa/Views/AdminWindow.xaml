<Window x:Class="Stolovayaa.Views.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Админ-панель"
        Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#E8F0FE">

    <Window.Resources>
        <Style x:Key="BeigeButton" TargetType="Button">
            <Setter Property="Background" Value="#D9C7A7"/>
            <Setter Property="Foreground" Value="#4A3F2A"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="17">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C9B48F"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#B8A178"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="White" CornerRadius="15" Margin="15" Padding="20">
        <TabControl Background="Transparent" BorderThickness="0">

            <TabItem Header="Пользователи и роли">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid Grid.Row="0"
                              ItemsSource="{Binding Users}"
                              SelectedItem="{Binding SelectedUser}"
                              AutoGenerateColumns="False"
                              BorderThickness="0"
                              Background="White"
                              RowBackground="White"
                              AlternatingRowBackground="#FBF7F0"
                              GridLinesVisibility="None">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="*"/>
                            <DataGridTextColumn Header="Имя" Binding="{Binding FirstName}" Width="*"/>
                            <DataGridTextColumn Header="Фамилия" Binding="{Binding LastName}" Width="*"/>
                            <DataGridTextColumn Header="Роль" Binding="{Binding RoleName}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Добавить" Command="{Binding AddUserCommand}"
                                Style="{StaticResource BeigeButton}" Margin="0,0,10,0" Width="133"/>
                        <Button Content="Изменить" Command="{Binding EditUserCommand}"
                                Style="{StaticResource BeigeButton}" Margin="0,0,10,0" Width="140"/>
                        <Button Content="Удалить" Command="{Binding DeleteUserCommand}"
                                Style="{StaticResource BeigeButton}" Width="145"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Ученики">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid Grid.Row="0"
                              ItemsSource="{Binding Schoolboys}"
                              SelectedItem="{Binding SelectedSchoolboy}"
                              AutoGenerateColumns="False"
                              BorderThickness="0"
                              Background="White"
                              RowBackground="White"
                              AlternatingRowBackground="#FBF7F0"
                              GridLinesVisibility="None">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Фамилия" Binding="{Binding LastName}" Width="*"/>
                            <DataGridTextColumn Header="Имя" Binding="{Binding FirstName}" Width="*"/>
                            <DataGridTextColumn Header="Класс" Binding="{Binding ClassNumber}" Width="80"/>
                            <DataGridTextColumn Header="Баланс" Binding="{Binding Balans}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Добавить" Command="{Binding AddSchoolboyCommand}"
                                Style="{StaticResource BeigeButton}" Margin="0,0,10,0" Width="118"/>
                        <Button Content="Изменить" Command="{Binding EditSchoolboyCommand}"
                                Style="{StaticResource BeigeButton}" Margin="0,0,10,0" Width="125"/>
                        <Button Content="Удалить" Command="{Binding DeleteSchoolboyCommand}"
                                Style="{StaticResource BeigeButton}" Width="95"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Блюда и меню">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid Grid.Row="0"
                              ItemsSource="{Binding Dishes}"
                              SelectedItem="{Binding SelectedDish}"
                              AutoGenerateColumns="False"
                              BorderThickness="0"
                              Background="White"
                              RowBackground="White"
                              AlternatingRowBackground="#FBF7F0"
                              GridLinesVisibility="None">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="*"/>
                            <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="150"/>
                            <DataGridTextColumn Header="Цена" Binding="{Binding Price}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Добавить блюдо" Command="{Binding AddDishCommand}"
                                Style="{StaticResource BeigeButton}" Margin="0,0,10,0" Width="158"/>
                        <Button Content="Изменить" Command="{Binding EditDishCommand}"
                                Style="{StaticResource BeigeButton}" Margin="0,0,10,0" Width="110"/>
                        <Button Content="Удалить" Command="{Binding DeleteDishCommand}"
                                Style="{StaticResource BeigeButton}" Width="105"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Заказы и отчёты">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid Grid.Row="0"
                              ItemsSource="{Binding Orders}"
                              SelectedItem="{Binding SelectedOrder}"
                              AutoGenerateColumns="False"
                              BorderThickness="0"
                              Background="White"
                              RowBackground="White"
                              AlternatingRowBackground="#FBF7F0"
                              GridLinesVisibility="None">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№" Binding="{Binding Id}" Width="60"/>
                            <DataGridTextColumn Header="Ученик" Binding="{Binding SchoolboyName}" Width="*"/>
                            <DataGridTextColumn Header="Дата" Binding="{Binding OrderDate}" Width="140"/>
                            <DataGridTextColumn Header="Сумма" Binding="{Binding TotalAmount}" Width="100"/>
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="📊 Сформировать отчёт" Command="{Binding CreateReportCommand}"
                                Style="{StaticResource BeigeButton}"/>
                    </StackPanel>
                </Grid>
            </TabItem>

        </TabControl>
    </Border>
</Window>