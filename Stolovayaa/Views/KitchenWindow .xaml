<Window x:Class="Stolovayaa.Views.KitchenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Кухня"
        Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#E8F0FE">

    <Window.Resources>
        <Style x:Key="BeigeButton" TargetType="Button">
            <Setter Property="Background" Value="#D9C7A7"/>
            <Setter Property="Foreground" Value="#4A3F2A"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="17">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C9B48F"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#B8A178"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BeigeDarkButton" TargetType="Button" BasedOn="{StaticResource BeigeButton}">
            <Setter Property="Background" Value="#C9B48F"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#B8A178"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#A69064"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="White" CornerRadius="15" Margin="15" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="🍳 Кухня — заказы на сегодня"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#2C3E50"
                       Margin="0,0,0,12"/>

            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding Orders}"
                      SelectedItem="{Binding SelectedOrder}"
                      AutoGenerateColumns="False"
                      BorderThickness="0"
                      Background="White"
                      RowBackground="White"
                      AlternatingRowBackground="#FBF7F0"
                      GridLinesVisibility="None"
                      HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="№" Binding="{Binding Id}" Width="60"/>
                    <DataGridTextColumn Header="Ученик" Binding="{Binding SchoolboyName}" Width="*"/>
                    <DataGridTextColumn Header="Дата" Binding="{Binding OrderDate}" Width="140"/>
                    <DataGridTextColumn Header="Сумма" Binding="{Binding TotalAmount}" Width="100"/>
                    <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                <Button Content="Готовится" Command="{Binding SetCookingCommand}"
                        Style="{StaticResource BeigeButton}" Margin="0,0,10,0" Width="120"/>
                <Button Content="Готово" Command="{Binding SetReadyCommand}"
                        Style="{StaticResource BeigeButton}" Width="131"/>
            </StackPanel>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="📊 Сформировать отчёт за день"
                        Command="{Binding CreateReportCommand}"
                        Style="{StaticResource BeigeDarkButton}" Width="255"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>